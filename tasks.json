{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build prioritask",
            "type": "shell",
            "command": "g++",
            "args": ["-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-g", "src/main.cpp", "-o", "prioritask.exe"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}
